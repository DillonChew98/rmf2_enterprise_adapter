# ── Enterprise Adapter configuration ────────────────────────────────────────
# Copy this to `adapter.env` and edit for your site:
#     cp adapter.env.example adapter.env
# Docker loads it into the adapter container (see `env_file` in
# docker-compose.yaml). Do NOT commit `adapter.env` with real secrets.

# LIMS backend: "tiberius" (real SQL Server) or "mock" (in-memory, no DB).
LIMS_BACKEND=tiberius

# ── SQL Server LIMS connection (used when LIMS_BACKEND=tiberius) ─────────────
# Demo stack: MSSQL_HOST=mssql (the bundled compose service).
# Production:  point these at your real LIMS server, e.g. lims.corp.local.
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DATABASE=LIMS
MSSQL_USER=sa
MSSQL_PASSWORD=Your_strong_Pass123
# true  = trust the server's certificate (self-signed / dev).
# false = verify against a real CA (recommended in production).
MSSQL_TRUST_CERT=true

# ── HTTP ────────────────────────────────────────────────────────────────────
# The adapter listens here; the UI's nginx proxies /api to it.
BIND_ADDR=0.0.0.0:7900

# ── MQTT device link (adapter <-> delayering machine) ───────────────────────
# Demo stack: mosquitto (the bundled broker).
# Production:  your MQTT broker / machine gateway host.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MACHINE_MANUFACTURER=acme-delayer
MACHINE_DEVICE_ID=delayer-01

# ── Chemical catalog (one chemical per line; built-in defaults if missing) ──
CHEMICALS_FILE=chemicals.txt
