# VITE_USE_MOCK governs LIMS jobs + job submission only:
#   false -> call the real rmf2_enterprise_adapter REST API (default for dev)
#   true  -> run fully standalone on the in-browser seed (no adapter needed)
# Machine status is always the in-browser simulation (no device backend yet).
VITE_USE_MOCK=false
VITE_API_URL=http://127.0.0.1:7900
VITE_DISPLAY_TIMEZONE=Asia/Singapore
