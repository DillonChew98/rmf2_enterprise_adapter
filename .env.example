# LIMS backend: "tiberius" (real SQL Server) or "mock" (in-memory, no DB).
LIMS_BACKEND=tiberius

# SQL Server connection (used when LIMS_BACKEND=tiberius).
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=LIMS
MSSQL_USER=sa
MSSQL_PASSWORD=Your_strong_Pass123
# Trust the dev container's self-signed certificate.
MSSQL_TRUST_CERT=true

# HTTP bind address for the adapter (the UI's VITE_API_URL points here).
BIND_ADDR=0.0.0.0:7900

# MQTT device link (controller <-> mock delayering machine).
MQTT_HOST=localhost
MQTT_PORT=1883
MACHINE_MANUFACTURER=acme-delayer
MACHINE_DEVICE_ID=delayer-01

# Chemical catalog source (one chemical per line; built-in defaults if missing).
CHEMICALS_FILE=chemicals.txt
